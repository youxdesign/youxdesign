---
/* Santé contemporaine : intérieur clair et apaisé (fenêtre, plante, fauteuil),
   formes simples et arrondies, en attendant les vraies photos. */
interface Props { type: 'portrait' | 'cabinet' | 'ambiance'; cab: any; variante?: number }
const { type, cab } = Astro.props;
---
{type === 'portrait' ? (
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="400" height="500" />
    <circle class="il-doux2" cx="200" cy="215" r="120" />
    <circle class="il-accent" cx="200" cy="190" r="56" />
    <path class="il-accent" d="M86 500c6-92 54-150 114-150s108 58 114 150z" />
    <text class="il-texte" x="200" y="210" text-anchor="middle" font-size="48">{cab.initiales}</text>
  </svg>
) : type === 'cabinet' ? (
  <svg viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="450" />
    <rect class="il-surface" x="320" y="50" width="200" height="230" rx="18" />
    <path class="il-trait" d="M420 50v230M320 165h200" />
    <path class="il-doux2" d="M0 340h600v110H0z" />
    <rect class="il-accent" x="90" y="230" width="190" height="90" rx="30" />
    <rect class="il-accent" x="70" y="190" width="40" height="130" rx="20" />
    <rect class="il-accent" x="260" y="190" width="40" height="130" rx="20" />
    <path class="il-encre" d="M110 320h12v40h-12zM248 320h12v40h-12z" opacity=".5" />
    <path class="il-clair" d="M500 340c-6-40 4-80 30-104 6 30 0 70-14 104zM520 340c10-34 34-58 64-66-4 30-24 54-52 66z" />
  </svg>
) : (
  <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="400" />
    <circle class="il-doux2" cx="430" cy="140" r="90" />
    <path class="il-clair" d="M0 280c120-40 240-40 360-10s160 20 240 0v130H0z" />
    <path class="il-accent" d="M0 330c140-30 280-26 400 0s140 14 200 4v66H0z" opacity=".85" />
  </svg>
)}
