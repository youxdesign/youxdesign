---
/* Nocturne : intérieurs et paysages du soir (fenêtre sous la lune, lampe,
   collines dans la nuit), en attendant les vraies photos. */
interface Props { type: 'portrait' | 'cabinet' | 'ambiance'; cab: any; variante?: number }
const { type } = Astro.props;
const id = `no-${type}`;
---
{type === 'cabinet' ? (
  <svg viewBox="0 0 1200 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={id} cx=".7" cy=".4" r=".6">
        <stop offset="0" class="no-s-lueur" /><stop offset="1" class="no-s-nuit" />
      </radialGradient>
    </defs>
    <rect width="1200" height="520" fill={`url(#${id})`} />
    <rect class="no-fenetre" x="150" y="70" width="230" height="300" rx="115" />
    <circle class="no-lune" cx="300" cy="150" r="28" />
    <path class="no-colline" d="M150 300c40-24 90-30 130-14s70 10 100-6v90H150z" />
    <path class="no-sol" d="M0 440h1200v80H0z" />
    <ellipse class="no-tapis" cx="860" cy="452" rx="250" ry="22" />
    <path class="no-meuble" d="M760 440V300c0-40 30-60 80-60h120c40 0 70 20 70 60v140" />
    <path class="no-meuble" d="M740 340h320" />
    <circle class="no-lampe" cx="640" cy="200" r="46" />
    <path class="no-pied" d="M640 246v194M610 440h60" />
  </svg>
) : type === 'portrait' ? (
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={id} cx=".5" cy=".35" r=".7">
        <stop offset="0" class="no-s-lueur" /><stop offset="1" class="no-s-nuit" />
      </radialGradient>
    </defs>
    <rect width="400" height="500" fill={`url(#${id})`} />
    <circle class="no-lune" cx="200" cy="170" r="70" />
    <path class="no-colline" d="M0 380c70-40 140-50 210-24s130 20 190-6v150H0z" />
    <path class="no-sol" d="M0 440c100-30 200-30 300-6s70 10 100 0v66H0z" />
  </svg>
) : (
  <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id={id} cx=".65" cy=".3" r=".7">
        <stop offset="0" class="no-s-lueur" /><stop offset="1" class="no-s-nuit" />
      </radialGradient>
    </defs>
    <rect width="600" height="400" fill={`url(#${id})`} />
    <circle class="no-lune" cx="400" cy="120" r="40" />
    <path class="no-colline" d="M0 280c120-50 240-56 360-20s170 26 240-4v144H0z" />
    <path class="no-sol" d="M0 330c150-36 300-30 420 0s130 16 180 4v66H0z" />
  </svg>
)}
