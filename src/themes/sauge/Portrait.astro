---
/* ==========================================================================
   Portrait (ou photo du cabinet) du style « Sauge » : un dégradé sauge avec
   les initiales en grand, ou la vraie photo si elle a été déposée dans
   cabinets/<cabinet>/images/ (portrait.jpg, cabinet.jpg…). Légende en verre
   dépoli, dévoilement de haut en bas et léger effet de profondeur.
   ========================================================================== */
import { de } from '../../lib/texte.mjs';
import { Picture } from 'astro:assets';
const images = import.meta.glob<{ default: ImageMetadata }>('/cabinets/*/images/*.{jpg,jpeg,png,webp,avif}', { eager: true });

interface Props { site: any; type: 'portrait' | 'cabinet'; titre: string; detail?: string; complement?: string }
const { site, type, titre, detail, complement } = Astro.props;
const cab = site.cab;
const cherche = (t) => Object.entries(images).find(([chemin]) => chemin.startsWith(`/cabinets/${cab.id}/images/${t}.`));
/* À défaut de la photo demandée, l'autre (portrait ou cabinet) plutôt que les initiales */
const autre = type === 'portrait' ? 'cabinet' : 'portrait';
const trouve = cherche(type) || cherche(autre);
const montre = trouve && !cherche(type) ? autre : type;
const photo = trouve ? trouve[1].default : null;
const mono = cab.initiales[0] + cab.initiales.slice(1).toLowerCase();
const alt = montre === 'portrait' ? `Portrait ${de(cab.nomComplet)}` : `Le cabinet ${de(cab.nomComplet)}`;
/* « Le cabinet… » ne va pas sous un portrait : on légende avec le nom */
const legende = montre === 'portrait' && type === 'cabinet'
  ? { titre: cab.nomComplet, detail: cab.praticien.titre, complement }
  : { titre, detail, complement };
---
<figure class="portrait" data-mask data-visuel={type}>
  {photo ? (
    <Picture src={photo} alt={alt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 640, 900]} sizes="(min-width: 900px) 40vw, 92vw" loading="lazy" />
  ) : (
    <div class="portrait__mono" data-parallax="0.12" aria-hidden="true">{mono}</div>
  )}
  <figcaption class="portrait__caption">
    <span><strong>{legende.titre}</strong>{legende.detail && <><br />{legende.detail}</>}</span>
    {legende.complement && <span class="muted">{legende.complement}</span>}
  </figcaption>
</figure>
