---
/* Grand titre révélé ligne par ligne (une ligne par retour à la ligne de la
   fiche). L'animation est purement CSS : sans elle, le titre reste lisible. */
import { lignes } from '../../lib/texte.mjs';
interface Props { texte: string; classe?: string; id?: string }
const { texte, classe = 'h1', id = 'titre-page' } = Astro.props;
---
<h1 class={classe} id={id}>
  {lignes(texte).map((l) => <span class="split-line"><span set:html={l} /></span>)}
</h1>
