---
/* Éditorial : natures mortes en aplats (fauteuil, lampe, livres, fenêtre),
   comme des illustrations de magazine, en attendant les vraies photos. */
interface Props { type: 'portrait' | 'cabinet' | 'ambiance'; cab: any; variante?: number }
const { type } = Astro.props;
---
{type === 'portrait' ? (
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="400" height="500" />
    <rect class="il-surface" x="70" y="60" width="150" height="210" />
    <path class="il-trait" d="M145 60v210M70 165h150" />
    <path class="il-doux2" d="M0 400h400v100H0z" />
    <path class="il-accent" d="M200 420v-130c0-40 30-60 70-60h20c30 0 50 20 50 50v140z" />
    <path class="il-encre" d="M190 330h150v50H190z" opacity=".85" />
    <path class="il-tige" d="M205 420v40M325 420v40M110 290v170M86 290h48" />
    <path class="il-clair" d="M80 260h60l-12-50H92z" />
  </svg>
) : type === 'cabinet' ? (
  <svg viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="450" />
    <rect class="il-surface" x="360" y="50" width="170" height="230" />
    <path class="il-trait" d="M445 50v230M360 165h170" />
    <path class="il-doux2" d="M0 330h600v120H0z" />
    <rect class="il-encre" x="80" y="230" width="210" height="16" />
    <path class="il-tige" d="M105 246v100M265 246v100" />
    <rect class="il-accent" x="110" y="196" width="30" height="34" />
    <rect class="il-clair" x="142" y="186" width="22" height="44" />
    <rect class="il-encre" x="166" y="204" width="26" height="26" opacity=".7" />
    <path class="il-tige" d="M240 230v-70M222 160h36" />
    <path class="il-accent" d="M216 160h48l-10-38h-28z" />
  </svg>
) : (
  <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="400" />
    <rect class="il-surface" x="60" y="50" width="200" height="250" />
    <path class="il-trait" d="M160 50v250M60 175h200" />
    <circle class="il-accent" cx="430" cy="180" r="80" />
    <path class="il-doux2" d="M0 310h600v90H0z" />
  </svg>
)}
