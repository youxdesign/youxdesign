---
/* Minimalisme suisse : compositions géométriques façon affiche (grille,
   cercle de couleur, aplats noirs), en attendant les vraies photos. */
interface Props { type: 'portrait' | 'cabinet' | 'ambiance'; cab: any }
const { type, cab } = Astro.props;
---
{type === 'portrait' ? (
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="400" height="500" />
    <path class="il-trait" d="M100 0v500M200 0v500M300 0v500M0 125h400M0 250h400M0 375h400" />
    <circle class="il-accent" cx="262" cy="196" r="128" />
    <rect class="il-encre" y="330" width="200" height="170" />
    <rect class="il-papier" x="200" y="375" width="100" height="125" />
    <circle class="il-encre" cx="100" cy="125" r="22" />
    <text class="il-texte" x="22" y="470" font-size="104" letter-spacing="-5">{cab.initiales}</text>
  </svg>
) : type === 'cabinet' ? (
  <svg viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="450" />
    <path class="il-trait" d="M150 0v450M300 0v450M450 0v450M0 150h600M0 300h600" />
    <rect class="il-papier" x="150" y="54" width="150" height="228" />
    <path class="il-trait" d="M225 54v228M150 168h150" />
    <circle class="il-accent" cx="384" cy="196" r="82" />
    <rect class="il-encre" x="150" y="282" width="150" height="18" />
    <rect class="il-encre" x="300" y="300" width="300" height="150" />
    <rect class="il-encre" x="186" y="300" width="14" height="150" />
  </svg>
) : (
  <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <rect class="il-fond" width="600" height="400" />
    <path class="il-trait" d="M150 0v400M300 0v400M450 0v400M0 200h600" />
    <circle class="il-accent" cx="300" cy="200" r="120" />
    <rect class="il-encre" y="260" width="600" height="140" />
    <rect class="il-papier" x="450" y="260" width="150" height="140" />
  </svg>
)}
