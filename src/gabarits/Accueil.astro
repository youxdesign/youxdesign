---
import Site from '../layouts/Site.astro';
import OuvertureBase from '../components/Ouverture.astro';
import TitreSection from '../components/TitreSection.astro';
import Visuel from '../components/Visuel.astro';
import Urgence from '../components/Urgence.astro';
import Respiration from '../components/Respiration.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { ouvertures } from '../themes/registre.mjs';
import { lien } from '../lib/site.mjs';
import { meta, donneesCabinet } from '../lib/seo.mjs';

interface Props { site: any }
const { site } = Astro.props;
const cab = site.cab, p = cab.praticien, c = cab.cabinet, t = cab.pages.accueil;
const Ouverture = ouvertures[site.theme] || OuvertureBase;
const m = meta(site, 'accueil');
const scripts = [cab.a('statut') && 'statut', cab.a('respiration') && 'respiration'].filter(Boolean);

const reperes = [
  p.diplome && { titre: `${cab.metier} ${cab.accord('diplômé')}`, texte: p.diplome },
  p.adeli ? { titre: `N° ADELI ${p.adeli}`, texte: cab.estPsychologue ? 'Titre de psychologue enregistré à l’ARS' : 'Numéro professionnel' }
    : p.rpps && { titre: `N° RPPS ${p.rpps}`, texte: 'Répertoire partagé des professionnels de santé' },
  { titre: `Cabinet à ${c.ville}${c.visio ? ' et visio' : ''}`, texte: `${c.adresse}${c.quartier ? ', ' + c.quartier : ''}` },
  cab.rdv ? { titre: 'Rendez-vous en ligne', texte: `Réservation à toute heure sur ${cab.rdv.plateforme}` } : { titre: 'Rendez-vous par téléphone', texte: cab.tel.affiche }
].filter(Boolean);
---
<Site site={site} page="accueil" titre={m.titre} description={m.description} chemin={site.base} jsonld={[donneesCabinet(site)]} scripts={scripts}>
  <Ouverture site={site} />

  <section class="section section--serree section-reperes" aria-label="En bref">
    <div class="conteneur">
      <ul class="reperes">
        {reperes.map((r) => (
          <li class="repere">
            <span class="repere__titre">{r.titre}</span>
            <span class="repere__texte">{r.texte}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {cab.motifs.length > 0 && (
    <section class="section section-motifs" aria-labelledby="motifs-titre">
      <div class="conteneur">
        <TitreSection surtitre="Motifs de consultation" numero={1} titre={t.motifsTitre} intro={t.motifsIntro} id="motifs-titre" />
        <ul class="grille cartes motifs">
          {cab.motifs.map((x, i) => (
            <li class="carte motif apparait">
              <span class="motif__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{x.titre}</h3>
              {x.texte && <p>{x.texte}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--teinte section-presentation" aria-labelledby="presentation-titre">
    <div class="conteneur deux-colonnes presentation">
      <Visuel site={site} type="portrait" legende={`${cab.nomComplet} · ${p.titre}${p.depuis ? ` depuis ${p.depuis}` : ''}`} />
      <div class="presentation__texte">
        <p class="surtitre"><span class="surtitre__num" aria-hidden="true">02</span><span>Présentation</span></p>
        <h2 id="presentation-titre">{t.presentationTitre}</h2>
        <div class="texte">
          {t.presentation.map((x) => <p>{x}</p>)}
        </div>
        <a class="lien-fleche" href={lien(site, 'a-propos')}>Mon parcours et ma façon de travailler</a>
      </div>
    </div>
  </section>

  <section class="section section-etapes" aria-labelledby="etapes-titre">
    <div class="conteneur">
      <TitreSection surtitre="Première séance" numero={3} titre={t.etapesTitre} intro={t.etapesIntro} id="etapes-titre" />
      <ol class="etapes">
        {t.etapes.map((e, i) => (
          <li class="etape apparait">
            <span class="etape__num" aria-hidden="true">{i + 1}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {cab.a('respiration') && <Respiration titre={t.respirationTitre} texte={t.respirationTexte} />}

  <div class="section section-urgence-accueil">
    <div class="conteneur"><Urgence cab={cab} /></div>
  </div>

  <AppelFinal cab={cab} titre={t.finTitre} texte={t.finTexte} />
</Site>
