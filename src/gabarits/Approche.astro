---
import Site from '../layouts/Site.astro';
import TetePage from '../components/TetePage.astro';
import TitreSection from '../components/TitreSection.astro';
import Cercle from '../components/Cercle.astro';
import AppelFinal from '../components/AppelFinal.astro';
import { lien } from '../lib/site.mjs';
import { meta, donneesFil } from '../lib/seo.mjs';

interface Props { site: any }
const { site } = Astro.props;
const cab = site.cab, t = cab.pages.approche;
const m = meta(site, 'approche');
---
<Site site={site} page="approche" titre={m.titre} description={m.description} chemin={lien(site, 'approche')} jsonld={[donneesFil(site, 'approche')]}>
  <TetePage surtitre="Mon approche" titre={t.titre} titreSuite={t.titreSuite} intro={t.intro} />

  {t.cercle && (
    <section class="section section--teinte" aria-labelledby="cercle-titre-section">
      <div class="conteneur deux-colonnes">
        <div>
          <TitreSection surtitre="Le principe" numero={1} titre={t.cercleTitre} id="cercle-titre-section" />
          <div class="texte">{t.cercle.map((x) => <p>{x}</p>)}</div>
        </div>
        {t.cercleEtiquettes && <Cercle etiquettes={t.cercleEtiquettes} />}
      </div>
    </section>
  )}

  {t.deroule && (
    <section class="section" aria-labelledby="deroule-titre">
      <div class="conteneur">
        <TitreSection surtitre="Le déroulé" numero={2} titre={t.derouleTitre} intro={t.derouleIntro} id="deroule-titre" />
        <ol class="chronologie">
          {t.deroule.map((j) => (
            <li class="jalon apparait">
              <span class="jalon__date">{j.date}</span>
              <h3>{j.titre}</h3>
              {j.texte && <p>{j.texte}</p>}
            </li>
          ))}
        </ol>
        {t.dureeTitre && (
          <div class="encadre apparait">
            <h3>{t.dureeTitre}</h3>
            <p>{t.dureeTexte}</p>
          </div>
        )}
      </div>
    </section>
  )}

  {t.outils && (
    <section class="section section--teinte" aria-labelledby="outils-titre">
      <div class="conteneur">
        <TitreSection surtitre="Les outils" numero={3} titre={t.outilsTitre} intro={t.outilsIntro} id="outils-titre" />
        <ul class="grille cartes outils">
          {t.outils.map((o) => (
            <li class="carte apparait">
              <h3>{o.titre}</h3>
              {o.texte && <p>{o.texte}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {t.cadre && (
    <section class="section" aria-labelledby="cadre-titre">
      <div class="conteneur deux-colonnes deux-colonnes--texte">
        <TitreSection surtitre="Le cadre" numero={4} titre={t.cadreTitre} intro={t.cadreIntro} id="cadre-titre" />
        <ul class="coches">
          {t.cadre.map((x) => <li class="apparait">{x}</li>)}
        </ul>
      </div>
    </section>
  )}

  <AppelFinal cab={cab} titre={t.finTitre} texte={t.finTexte} />
</Site>
