---
/* Politique de confidentialité (textes : src/lib/legal.mjs) */
import Site from '../layouts/Site.astro';
import TetePage from '../components/TetePage.astro';
import { lien } from '../lib/site.mjs';
import { meta } from '../lib/seo.mjs';
import { confidentialite } from '../lib/legal.mjs';

interface Props { site: any }
const { site } = Astro.props;
const cab = site.cab;
const m = meta(site, 'confidentialite');
const rubriques = confidentialite(cab);
---
<Site site={site} page="confidentialite" titre={m.titre} description={m.description} chemin={lien(site, 'confidentialite')} indexable={false}>
  <TetePage surtitre="Informations légales" titre="Politique de confidentialité" intro={`Dernière mise à jour : ${cab.legal.miseAJour}`} classe="tete-page--legal" />
  <section class="section section--serree">
    <div class="conteneur legal">
      {rubriques.map((r) => r.resume ? (
        <div class="en-bref" id={r.id}><strong>{r.titre} :</strong> <Fragment set:html={r.html.replace(/^<p>|<\/p>$/g, '')} /></div>
      ) : (
        <div id={r.id}>
          <h2>{r.titre}</h2>
          <Fragment set:html={r.html} />
        </div>
      ))}
    </div>
  </section>
</Site>
