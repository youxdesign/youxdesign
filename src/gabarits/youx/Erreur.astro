---
/* Page introuvable du site youXdesign */
import Youx from '../../layouts/Youx.astro';
import Entete from '../../components/youx/Entete.astro';
import Pied from '../../components/youx/Pied.astro';
---
<Youx titre="Page introuvable · youXdesign" description="Cette page n’existe pas ou a été déplacée." chemin={null} indexable={false} scripts={['vitrine']} classe="vt" feuille="vitrine" polices={['/fonts/inter-variable.woff2']}>
  <Entete />
  <main id="contenu" tabindex="-1" class="vt-page vt-erreur">
    <div class="vt-conteneur">
      <p class="vt-surtitre vt-entree">Erreur 404</p>
      <h1 class="vt-page__titre vt-entree">Cette page est <em>introuvable.</em></h1>
      <p class="vt-chapeau vt-entree">L’adresse a peut-être changé. Revenez à l’accueil ou configurez directement votre site.</p>
      <p class="vt-boutons vt-entree">
        <a class="vt-bouton vt-bouton--grand" href="/">Revenir à l’accueil</a>
        <a class="vt-bouton vt-bouton--grand vt-bouton--contour" href="/configurateur/">Configurer mon site</a>
      </p>
    </div>
  </main>
  <Pied />
</Youx>
