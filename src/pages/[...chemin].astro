---
/* ==========================================================================
   Routeur unique : fabrique toutes les pages à partir de src/lib/site.mjs.
   ========================================================================== */
import Accueil from '../gabarits/Accueil.astro';
import APropos from '../gabarits/APropos.astro';
import Approche from '../gabarits/Approche.astro';
import Consultations from '../gabarits/Consultations.astro';
import Faq from '../gabarits/Faq.astro';
import Contact from '../gabarits/Contact.astro';
import MentionsLegales from '../gabarits/MentionsLegales.astro';
import Confidentialite from '../gabarits/Confidentialite.astro';
import Erreur from '../gabarits/Erreur.astro';
import YouxAccueil from '../gabarits/youx/Accueil.astro';
import YouxErreur from '../gabarits/youx/Erreur.astro';
import { routes } from '../lib/site.mjs';

export function getStaticPaths() {
  return routes().map((r) => ({ params: { chemin: r.chemin }, props: { route: r } }));
}

const { route } = Astro.props;
const GABARITS = {
  accueil: Accueil,
  'a-propos': APropos,
  approche: Approche,
  consultations: Consultations,
  faq: Faq,
  contact: Contact,
  'mentions-legales': MentionsLegales,
  confidentialite: Confidentialite,
  404: Erreur
};
const Gabarit = route.type === 'page' ? GABARITS[route.page] : null;
---
{route.type === 'page' && <Gabarit site={route.site} />}
{route.type === 'configurateur' && <YouxAccueil />}
{route.type === 'erreur-youx' && <YouxErreur />}
