---
/* ==========================================================================
   Habillage commun des sites de cabinet : en-tête, contenu, pied de page.
   Un style peut fournir son propre habillage (src/themes/<style>/Cadre.astro) :
   le routeur l'utilise alors à la place de celui-ci.
   ========================================================================== */
import Document from './Document.astro';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { cadres, reglages } from '../themes/registre.mjs';
import Confort from '../components/options/Confort.astro';

interface Props {
  site: any;
  page: string;
  titre: string;
  description: string;
  chemin: string | null;
  indexable?: boolean;
  jsonld?: object[];
  scripts?: string[];
  classe?: string;
}
const { site, page, scripts = [], ...reste } = Astro.props;
const Cadre = cadres[site.theme];
/* Le bandeau d'information affiche le statut d'ouverture sur toutes les pages */
const statut = reglages(site.theme).bandeau && site.cab.bloc('statut', site.vitrine).rendre;
/* Agenda de réservation intégré (option « créneaux ») : chargé au clic */
const agenda = !site.vitrine && site.cab.a('creneaux') && site.cab.rdv?.agenda;
const props = { ...reste, site, page, scripts: [...scripts, statut && 'statut', agenda && 'carte'].filter(Boolean) };
---
{Cadre ? (
  <Cadre {...props}><slot /></Cadre>
) : (
  <Document {...props}>
    {site.vitrine && (
      <div class="bandeau-demo">
        <div class="conteneur">
          <p>Exemple de site réalisé par youXdesign : le cabinet présenté est fictif.</p>
          <a href="/configurateur/">Créer le site de mon cabinet →</a>
        </div>
      </div>
    )}
    <Entete site={site} page={page} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage site={site} />
    <Confort site={site} />
  </Document>
)}
