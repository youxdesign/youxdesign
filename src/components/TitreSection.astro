---
/* Titre de section : surtitre (avec numéro facultatif), titre, introduction. */
interface Props { surtitre?: string; titre: string; intro?: string; numero?: number; id?: string; centre?: boolean; niveau?: 2 | 3 }
const { surtitre, titre, intro, numero, id, centre = false, niveau = 2 } = Astro.props;
const Balise = `h${niveau}`;
---
<header class:list={['titre-section', { 'titre-section--centre': centre }]}>
  {surtitre && (
    <p class="surtitre">
      {numero != null && <span class="surtitre__num" aria-hidden="true">{String(numero).padStart(2, '0')}</span>}
      <span>{surtitre}</span>
    </p>
  )}
  <Balise id={id}>{titre}</Balise>
  {intro && <p class="chapeau">{intro}</p>}
  <slot />
</header>
