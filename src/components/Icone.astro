---
/* Petites icônes au trait, toujours décoratives (le texte voisin porte le sens). */
interface Props { nom: 'fleche' | 'externe' | 'telephone' | 'email' | 'lieu' | 'calendrier' | 'menu' | 'fermer' | 'alerte' | 'visio' | 'horloge' | 'repere'; classe?: string }
const { nom, classe } = Astro.props;
const traces = {
  fleche: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  externe: '<path d="M7 17 17 7M8 7h9v9"/>',
  telephone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  lieu: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  calendrier: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  fermer: '<path d="M6 6l12 12M18 6 6 18"/>',
  alerte: '<path d="M12 3 2 20h20L12 3z"/><path d="M12 10v4M12 17.5v.5"/>',
  visio: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="m16 10 5-3v10l-5-3"/>',
  horloge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  repere: '<path d="M12 22s-8-7-8-13a8 8 0 0 1 16 0c0 6-8 13-8 13z" fill="currentColor" stroke="none"/><circle cx="12" cy="9" r="3" fill="#fff" stroke="none"/>'
};
---
<svg class={classe} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={traces[nom]} />
