---
/* Ressources à télécharger.
   Démos : trois exemples. Site d'un cabinet : la liste « ressources » de la
   fiche, fichiers déposés dans cabinets/<cabinet>/fichiers/.
   Une ressource avec « apercu » (image de sa première page) est présentée
   comme une feuille posée sur une pile, qu'on peut ouvrir ou télécharger. */
import Bloc from './Bloc.astro';
import Picto from '../Picto.astro';
interface Props { site: any }
const { site } = Astro.props;
const exemples = [
  { titre: 'Le journal des pensées', detail: 'Fiche à imprimer · PDF', icone: 'livre' },
  { titre: 'Respiration guidée, 5 minutes', detail: 'Audio · MP3', icone: 'poumons' },
  { titre: 'Planifier des activités agréables', detail: 'Fiche à imprimer · PDF', icone: 'calendrier' }
];
const dossier = `${site.base}fichiers/`;
const liste = site.vitrine ? exemples : site.cab.ressources.map((r) => ({ ...r, icone: r.icone || 'livre', lien: dossier + r.fichier, image: r.apercu && dossier + r.apercu }));
const feuilles = liste.filter((r) => r.image);
const autres = liste.filter((r) => !r.image);
---
{liste.length > 0 && <Bloc site={site} id="ressources" titre="Ressources">
  <div class="opt-conteneur">
    <div class="opt-carte">
      <div class="opt-tete">
        <p class="opt-surtitre">Ressources</p>
        <h2 class="opt-titre" id="opt-ressources-titre">À télécharger</h2>
        <p class="opt-texte">Des fiches et des exercices à retrouver entre les séances.</p>
      </div>
      {feuilles.length > 0 && (
        <ul class="docs">
          {feuilles.map((r) => (
            <li class="doc">
              <a class="doc__pile" href={r.lien} target="_blank" rel="noopener" aria-label={`Ouvrir ${r.titre} (PDF, nouvel onglet)`}>
                <span class="doc__feuille">
                  <img src={r.image} alt="" width="700" height="990" loading="lazy" decoding="async" />
                </span>
                <span class="doc__voir" aria-hidden="true">Ouvrir</span>
              </a>
              <div class="doc__infos">
                <h3 class="doc__titre">{r.titre}</h3>
                {r.detail && <p class="opt-texte">{r.detail}</p>}
                {r.credit && <p class="doc__credit">{r.credit}</p>}
                <p class="opt-actions">
                  <a class="opt-bouton" href={r.lien} download>Télécharger<span class="sr-only"> : {r.titre}</span></a>
                  <a class="opt-lien" href={r.lien} target="_blank" rel="noopener">Voir en ligne<span class="sr-only"> (nouvel onglet)</span></a>
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
      {autres.length > 0 && (
        <ul class="opt-grille">
          {autres.map((r) => (
            <li class="opt-element">
              <span class="opt-pictogramme"><Picto nom={r.icone} /></span>
              <span class="opt-element__titre">{r.titre}</span>
              {r.detail && <span class="opt-element__detail">{r.detail}</span>}
              {r.lien
                ? <a class="opt-bouton opt-bouton--clair" href={r.lien} download>Télécharger<span class="sr-only"> : {r.titre}</span></a>
                : <button class="opt-bouton opt-bouton--clair" type="button" data-demo-action>Télécharger</button>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</Bloc>}
