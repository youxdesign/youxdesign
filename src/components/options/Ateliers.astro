---
/* Ateliers et groupes */
import Bloc from './Bloc.astro';
interface Props { site: any }
const { site } = Astro.props;
const cab = site.cab;
const liste = [
  { titre: 'Groupe « Apprivoiser son stress »', detail: '6 séances · les jeudis à 18 h 30 · 8 personnes au plus' },
  { titre: 'Atelier pleine conscience', detail: 'Un samedi par mois · 10 h – 12 h · débutants bienvenus' }
];
---
<Bloc site={site} id="ateliers" titre="Ateliers">
  <div class="opt-conteneur">
    <div class="opt-carte">
      <div class="opt-tete">
        <p class="opt-surtitre">Ateliers et groupes</p>
        <h2 class="opt-titre" id="opt-ateliers-titre">Avancer ensemble</h2>
        <p class="opt-texte">Des séances collectives en petit groupe, au cabinet. Inscription par téléphone ou par e-mail.</p>
      </div>
      <ul class="opt-liste">
        {liste.map((a) => <li><span class="opt-element__titre">{a.titre}</span><span class="opt-element__detail">{a.detail}</span></li>)}
      </ul>
      <p class="opt-actions"><a class="opt-bouton" href={cab.tel.lien}>Appeler pour s’inscrire</a><a class="opt-lien" href={`mailto:${cab.contact.email}`}>Écrire un e-mail</a></p>
    </div>
  </div>
</Bloc>
