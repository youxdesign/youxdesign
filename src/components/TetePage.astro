---
/* Haut des pages intérieures : surtitre, grand titre, introduction. */
import { enrichi } from '../lib/texte.mjs';
interface Props { surtitre?: string; titre: string; intro?: string; classe?: string }
const { surtitre, titre, intro, classe } = Astro.props;
---
<section class:list={['tete-page', classe]} aria-labelledby="titre-page">
  <div class="conteneur tete-page__grille">
    <div class="tete-page__texte">
      {surtitre && <p class="surtitre">{surtitre}</p>}
      <h1 id="titre-page" set:html={enrichi(titre)} />
      {intro && <p class="chapeau">{intro}</p>}
      <slot name="texte" />
    </div>
    <slot />
  </div>
</section>
